{
  "name": "formax-extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:runtime && npm run build:extension",
    "build:runtime": "tsc -p tsconfig.build.json",
    "build:extension": "tsc -p tsconfig.extension.json",
    "build:rust-native-host": "node scripts/copy-rust-native-host.js",
    "install:formax-runtime": "node scripts/install-formax-runtime.js",
    "package:dist": "npm run build && npm run build:rust-native-host && node scripts/package-dist.js",
    "release": "node scripts/release.js",
    "docs:browser-api": "node scripts/generate-browser-client-api-docs.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.extension.json --noEmit",
    "chat:llm": "node tests/scripts/llm-browser-chat.js",
    "chat:node-repl": "node tests/scripts/llm-node-repl-chat.js",
    "mcp:node-repl": "node mcp-node-repl/server.js",
    "test": "npm run build:runtime && vitest run",
    "test:llm": "node tests/scripts/llm-browser-agent.js",
    "test:llm-node-repl": "node tests/scripts/llm-node-repl-chat.js --self-check",
    "test:mcp-node-repl": "node tests/scripts/mcp-node-repl-smoke.js",
    "check:extension-installed": "node scripts/check-extension-installed.js --json",
    "check:native-host": "node scripts/check-native-host-manifest.js --json",
    "test:real": "node tests/scripts/real-browser-e2e.js",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.320",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
