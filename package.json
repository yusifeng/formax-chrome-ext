{
  "name": "formax-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:runtime && npm run build:extension",
    "build:runtime": "tsc -p tsconfig.build.json",
    "build:extension": "tsc -p tsconfig.extension.json",
    "build:extension-host": "npm run build:runtime && node scripts/build-extension-host-binary.js",
    "package:dist": "npm run build && node scripts/build-extension-host-binary.js && node scripts/package-dist.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.extension.json --noEmit",
    "chat:llm": "node test-scripts/llm-browser-chat.js",
    "chat:node-repl": "node test-scripts/llm-node-repl-chat.js",
    "mcp:node-repl": "node mcp-node-repl/server.js",
    "test": "npm run build:runtime && vitest run",
    "test:llm": "node test-scripts/llm-browser-agent.js",
    "test:mcp-node-repl": "node test-scripts/mcp-node-repl-smoke.js",
    "test:real": "node test-scripts/real-browser-e2e.js",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.320",
    "@types/node": "^24.0.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
